/test-results/
/playwright-report/
/playwright/.cache/

# Playwright user data (browsers state)
playwright_user_data/
playwright_user_data_*/

# Data directories (scraped data - keep structure but ignore content)
data/*/
!data/.gitkeep

# Database files
*.db
*.sqlite
*.sqlite3

# Debug screenshots
debug_*.png
SC*.png

# Test files created during development
test_*.ts
test_*.js

# Backup files
*.bak
*.backup

# Lock files (keep package-lock.json but ignore others)
yarn.lock

# Local configuration files
config/local_*
config/dev_*

# Secrets and credentials
secrets/
credentials/
*.pem
*.key
!public.key

# API keys and tokens
.api_keys
api_keys.json
tokens.json
