# Massachusetts Scraping System v1.0.0 - Environment Variables

# =============================================================================
# CONFIGURAÇÕES PRINCIPAIS
# =============================================================================

# Ambiente de execução
NODE_ENV=production

# Configurações do Playwright
PLAYWRIGHT_HEADLESS=false
DAYS_BACK=0

# Funcionalidades do sistema
ENABLE_ENRICHMENT=true
SEND_WEBHOOK=true
FORCE_REENRICHMENT=false

# =============================================================================
# INTEGRAÇÃO DE SERVIÇOS
# =============================================================================

# URL do webhook para envio de dados
WEBHOOK_URL=https://your-webhook-endpoint.com/massachusetts

# URL do serviço OCR (se utilizado)
OCR_API_URL=https://your-ocr-service.com/api/v1/ocr

# =============================================================================
# LOGGING E MONITORAMENTO
# =============================================================================

# Nível de log (error, warn, info, debug)
LOG_LEVEL=info

# =============================================================================
# CONFIGURAÇÕES DO PORTAINER/DOCKER
# =============================================================================

# Porta da API (futura)
API_PORT=3000

# Caminhos dos volumes (para Portainer)
DATA_PATH=/opt/massachusetts-scraper/data
CONFIG_PATH=/opt/massachusetts-scraper/config
LOGS_PATH=/opt/massachusetts-scraper/logs

# =============================================================================
# CONFIGURAÇÕES DO SCHEDULER AUTOMÁTICO
# =============================================================================

# Modo de execução do runner
# interactive = Menu interativo (padrão)
# 1 ou all = Executar todos os scrapers
# 2 ou preforeclosure = Executar apenas Pre-Foreclosure  
# 3 ou hoa = Executar apenas HOA
# 4 ou probate = Executar apenas Probate
# 5 ou foreclosure = Executar apenas Foreclosure
RUNNER_MODE=interactive

# Horário diário para execução automática (formato 24h, padrão: 9)
# Exemplo: 9 = 09:00, 14 = 14:00, 22 = 22:00
SCHEDULE_HOUR=9

# =============================================================================
# CONFIGURAÇÕES ESPECÍFICAS DOS RUNNERS
# =============================================================================

# Foreclosure Runner
FORECLOSURE_DELAY_MS=2000

# Probate Runner  
PROBATE_MAX_PAGES=50

# HOA Runner
HOA_RETRY_COUNT=3

# Pre-Foreclosure Runner
PREFORECLOSURE_TIMEOUT_MS=30000

# =============================================================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO (docker-compose.yml)
# =============================================================================

# Para desenvolvimento local apenas
COMPOSE_PROJECT_NAME=massachusetts-scraper-dev