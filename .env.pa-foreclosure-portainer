# --- CRON SCHEDULE ---
# Formato: minuto hora dia mês dia_da_semana
# Exemplos:
#   0 9 * * *     = Todos os dias às 9h
#   0 9,17 * * *  = Todos os dias às 9h e 17h
#   0 9 * * 1-5   = Segunda a sexta às 9h
#   */30 * * * *  = A cada 30 minutos
#   0 */6 * * *   = A cada 6 horas
CRON_SCHEDULE=0 9 * * *

# --- MODO DE EXECUÇÃO ---
# pa-foreclosure = Execução periódica com cron
# one-shot       = Execução única (para testes)
RUNNER_MODE=pa-foreclosure
