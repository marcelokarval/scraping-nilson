# =============================================================================
# MASSACHUSETTS SCRAPER - CONFIGURAÇÃO PORTAINER
# Runner: 5 (Foreclosure - Landmark Auction)
# Modo: Execução Automática Diária
# =============================================================================

# =============================================================================
# CONFIGURAÇÕES DO SCHEDULER
# =============================================================================

# Modo de execução - Runner 5 (Foreclosure apenas)
RUNNER_MODE=5

# Horário diário para execução (formato 24h)
# 6 = 06:00 da manhã (recomendado para produção)
SCHEDULE_HOUR=6

# =============================================================================
# CONFIGURAÇÕES DE SCRAPING
# =============================================================================

# Quantos dias para trás buscar (7 = última semana)
DAYS_BACK=7

# Executar em modo headless (sem interface gráfica)
PLAYWRIGHT_HEADLESS=true

# =============================================================================
# CONFIGURAÇÕES DE WEBHOOK
# =============================================================================

# URL do webhook para envio dos dados coletados
# IMPORTANTE: Substitua pela sua URL real
WEBHOOK_URL=https://webhook.site/#!/your-webhook-id

# Habilitar envio de webhook
SEND_WEBHOOK=true

# =============================================================================
# CONFIGURAÇÕES DE ENRIQUECIMENTO
# =============================================================================

# Habilitar enriquecimento com MassProperty (recomendado)
ENABLE_ENRICHMENT=true

# Forçar re-enriquecimento de propriedades já processadas
FORCE_REENRICHMENT=false

# =============================================================================
# CONFIGURAÇÕES DE AMBIENTE
# =============================================================================

# Ambiente de execução
NODE_ENV=production

# Nível de log (error, warn, info, debug)
LOG_LEVEL=info

# =============================================================================
# CONFIGURAÇÕES OPCIONAIS
# =============================================================================

# URL da API de OCR (opcional - deixe vazio se não usar)
OCR_API_URL=

# Porta da API interna (opcional)
API_PORT=3000

# =============================================================================
# CONFIGURAÇÕES DO PORTAINER/DOCKER
# =============================================================================

# Caminhos dos volumes (para Portainer)
DATA_PATH=/opt/massachusetts-scraper/data
CONFIG_PATH=/opt/massachusetts-scraper/config
LOGS_PATH=/opt/massachusetts-scraper/logs

# =============================================================================
# INSTRUÇÕES DE USO NO PORTAINER
# =============================================================================

# 1. No Portainer, vá em Stacks → Add stack
# 2. Nome: massachusetts-foreclosure
# 3. Cole o conteúdo do arquivo portainer-stack.yml
# 4. Na seção Environment variables, copie TODAS as variáveis acima
# 5. IMPORTANTE: Substitua WEBHOOK_URL pela sua URL real
# 6. Clique em "Deploy the stack"

# =============================================================================
# EXEMPLO DE WEBHOOK PAYLOAD
# =============================================================================

# O sistema enviará dados no formato:
# POST /sua-webhook
# Content-Type: application/json
